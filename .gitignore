# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# El gestor de paquetes es pnpm (ver "packageManager" en package.json).
# Estos lockfiles no deben volver al repo: si aparecen, es que alguien ha
# ejecutado npm/yarn por error y el árbol de dependencias ya no es el fijado.
package-lock.json
yarn.lock

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# datos de conexión del servidor (IP/usuario SSH) — NO publicar
/tools/deploy.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
